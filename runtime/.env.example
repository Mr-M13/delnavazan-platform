# Delnavazan Platform — local disposable test runtime configuration.
# Copy to runtime/.env and adjust only the values you need.

# --- Project / paths ---
# Absolute path to the repository root (the plugin itself).
DZN_REPO_ROOT=/Users/hamed/Library/Application Support/DelnavazanAgentBridge/workspaces/PLATFORM-LOCAL-TEST-RUNTIME

# Host directory that will hold the disposable WordPress core install.
# This is bind-mounted (not a named volume) so the concurrency runner can
# mount the exact same WordPress directory into its worker containers.
DZN_WP_DIR=./wordpress

# --- Compose ---
COMPOSE_PROJECT_NAME=dzn-platform-runtime

# --- Networking ---
# Published host port for the WordPress HTTP endpoint (loopback only).
DZN_WP_PORT=8080
# Published host port for the Mailpit SMTP catcher.
DZN_SMTP_PORT=1025
# Published host port for the Mailpit web UI.
DZN_MAILPIT_UI_PORT=8025

# --- Database ---
# MariaDB is the default. To use the previously-validated MySQL 8.4 image
# instead, set DZN_DB_IMAGE=mysql:8.4 (keep the rest identical).
DZN_DB_IMAGE=mariadb:11.4
DZN_DB_NAME=wordpress
DZN_DB_USER=wordpress
DZN_DB_PASSWORD=wordpress
DZN_DB_ROOT_PASSWORD=root

# --- WordPress ---
DZN_WP_IMAGE=wordpress:php8.3-apache
DZN_CLI_IMAGE=wordpress:cli-php8.3
DZN_WP_ENVIRONMENT_TYPE=local
DZN_WP_TITLE="Delnavazan Platform (disposable)"
DZN_WP_URL=http://localhost:8080
DZN_WP_ADMIN_USER=admin
DZN_WP_ADMIN_PASSWORD=admin
DZN_WP_ADMIN_EMAIL=admin@example.invalid

# --- Mail ---
DZN_MAILPIT_IMAGE=axllent/mailpit:latest
